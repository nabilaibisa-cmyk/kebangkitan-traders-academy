rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // A user can create their own profile document, but only with
      // premium starting as false — premium can never be set to true by
      // the client, only by the Midtrans webhook via the Admin SDK
      // (which bypasses these rules entirely).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.premium == false;

      // Updates are allowed as long as `premium` is left untouched.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.premium == resource.data.premium;

      match /journal/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /simTrades/{tradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
