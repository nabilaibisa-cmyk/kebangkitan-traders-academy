# Copy this file to .env for local development and fill in your own
# Firebase project values (Firebase Console > Project Settings > General
# > Your apps > SDK setup and configuration). These are safe to expose
# in a client app, but keep them in env vars for easy setup per
# environment (dev / staging / production).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Midtrans (payment for the Level 4 premium unlock) ---
# Client Key is public/safe for the frontend (Midtrans Dashboard > Settings > Access keys)
VITE_MIDTRANS_CLIENT_KEY=

# Server Key is SECRET — only used server-side by Netlify Functions, never
# exposed to the browser. Get both from the same Access keys page.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_PREMIUM_PRICE=49000

# --- Firebase Admin SDK (used only by the Netlify Function that handles
# Midtrans's payment webhook, to unlock premium in Firestore) ---
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
